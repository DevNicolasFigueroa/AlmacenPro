# Configuración del servidor
PORT=4000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=almacenpro

# Autenticación JWT (usar una cadena larga y aleatoria en producción)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
# La sesión dura 8 horas fijas desde el inicio de sesión (definido en el código).

# Demostración pública (opcional). `npm run demo -- --confirmar` BORRA todos los datos de la base
# DB_NAME y crea una cuenta de administrador y una de cajero. Con MODO_DEMO=true el inicio de sesión
# muestra esas cuentas y sus contraseñas: no activarlo en un almacén real.
# MODO_DEMO=true
